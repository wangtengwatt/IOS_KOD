require_relative '../../../kod-source-unification/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '17.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../kod-source-unification/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../kod-source-unification/node_modules/@capacitor/ios'
  pod 'CapacitorCommunitySqlite', :path => '../../../kod-source-unification/node_modules/@capacitor-community/sqlite'
  pod 'CapacitorApp', :path => '../../../kod-source-unification/node_modules/@capacitor/app'
  pod 'CapacitorAppLauncher', :path => '../../../kod-source-unification/node_modules/@capacitor/app-launcher'
  pod 'CapacitorBrowser', :path => '../../../kod-source-unification/node_modules/@capacitor/browser'
  pod 'CapacitorDevice', :path => '../../../kod-source-unification/node_modules/@capacitor/device'
  pod 'CapacitorFilesystem', :path => '../../../kod-source-unification/node_modules/@capacitor/filesystem'
  pod 'CapacitorKeyboard', :path => '../../../kod-source-unification/node_modules/@capacitor/keyboard'
  pod 'CapacitorShare', :path => '../../../kod-source-unification/node_modules/@capacitor/share'
  pod 'CapacitorSplashScreen', :path => '../../../kod-source-unification/node_modules/@capacitor/splash-screen'
  pod 'CapacitorToast', :path => '../../../kod-source-unification/node_modules/@capacitor/toast'
  pod 'CapacitorPluginSafeArea', :path => '../../../kod-source-unification/node_modules/capacitor-plugin-safe-area'
  pod 'CapacitorStreamHttp', :path => '../../../kod-source-unification/node_modules/capacitor-stream-http'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
